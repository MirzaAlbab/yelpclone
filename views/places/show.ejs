<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= place.title%></title>
  </head>
  <body>
      <img src="<%= place.image %>" alt="" width="100" height="100">
        <%= place.title %>
        <%= place.price %>
        <%= place.location %>
