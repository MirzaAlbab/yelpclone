<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BestPoint - Places</title>
  </head>
  <body>
    <h1>All Places</h1>
    <a href="/places/create">New Place</a>
    <ul>
      <% for (const p of places) {%>
      <li>
        <%= p.title %>
        <a href="/places/<%= p._id %>">Show</a>
      </li>
      <% } %>
    </ul>
  </body>
</html>
