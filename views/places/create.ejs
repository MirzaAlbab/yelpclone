<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Add New place</title>
  </head>
  <body>
    <form action="/places" method="post">
      <div>
        <label for="title">Title</label>
        <input type="text" name="title" id="title" name="place[title]" />
      </div>
      <div>
        <label for="price">Price</label>
        <input type="number" name="price" id="price" name="place[price]" />
      </div>
      <div>
        <label for="description">Description</label>
        <input
          type="text"
          name="description"
          id="description"
          name="place[description]"
        />
      </div>
      <div>
        <label for="location">location</label>
        <input
          type="text"
          name="location"
          id="location"
          name="place[location]"
        />
      </div>
      <div>
        <label for="image">image</label>
        <input type="text" name="image" id="image" name="place[image]" />
      </div>
      <button type="submit">Add new place</button>
    </form>
  </body>
</html>
